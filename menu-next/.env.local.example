# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is in .gitignore.

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Web Push — VAPID public key (generate a VAPID key pair if you don't have one)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid-public-key>

# Test suite (supabase/tests/024_tabs_test.mjs)
# These credentials belong to accounts in the payment-test venue only.
# They are NOT production accounts.
TEST_OWNER_EMAIL=<test-owner-email>
TEST_OWNER_PASSWORD=<test-owner-password>
TEST_WAITER_A_CODE=<waiter-a-access-code>
TEST_WAITER_B_CODE=<waiter-b-access-code>
